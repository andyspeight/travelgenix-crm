# Supabase — get these from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Default agency ID (matches the bootstrap row in the schema)
NEXT_PUBLIC_AGENCY_ID=00000000-0000-0000-0000-000000000001

# Anthropic — added on day 5 when AI engine goes live
# ANTHROPIC_API_KEY=

# Optional — a Calendly (or other) booking URL. When set, the customer-360
# "Schedule call" button opens it in a new tab in addition to creating a task.
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/intro-call

# Optional — getAddress.io key for the postcode lookup on the customer forms.
# WITHOUT it the lookup still works, using the free postcodes.io service to
# validate a postcode and fill in the town and county. WITH it, the lookup
# returns the full list of real addresses at a postcode to pick from.
# GETADDRESS_API_KEY=
