# Supabase — get these from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Default agency ID (matches the bootstrap row in the schema)
NEXT_PUBLIC_AGENCY_ID=00000000-0000-0000-0000-000000000001

# Anthropic — added on day 5 when AI engine goes live
# ANTHROPIC_API_KEY=

# Optional — a Calendly (or other) booking URL. When set, the customer-360
# "Schedule call" button opens it in a new tab in addition to creating a task.
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/intro-call

# Ideal Postcodes address lookup (https://ideal-postcodes.co.uk).
#
# This is the PUBLIC, browser key (begins ak_) — it runs client-side in the
# customer forms, so it MUST be a key with your site's domains added to its
# "Allowed URLs". Because it only works from those whitelisted domains it is
# safe to expose in the browser, which is why it uses the NEXT_PUBLIC_ prefix.
# NB: NEXT_PUBLIC_ values are baked in at build time — set it, then redeploy.
# Without it the search box is hidden and addresses are typed by hand.
# NEXT_PUBLIC_IDEAL_POSTCODES_KEY=

# Control SSO (Luna suite shared sign-in). When set, the app is gated by
# Control's tg_session cookie instead of the interim access code. Point this at
# the Control deployment that answers /api/auth/me (e.g. https://widgets.travelify.io).
# CONTROL_BASE_URL=https://widgets.travelify.io
#
# Canonical host for Control mode. The tg_session cookie is scoped to
# .travelify.io, so the app must be reached at its travelify.io host — any other
# host (e.g. the raw *.vercel.app URL) carries no cookie and loops through
# sign-in. Middleware redirects non-canonical hosts here first. Defaults to
# crm.travelify.io; only set this to override for a white-label / renamed domain.
# CANONICAL_HOST=crm.travelify.io

# Customer portal (travellers view their own trips via a magic link).
# The portal ships DARK: it only exists when this signing secret is set, so it
# can be reviewed before going live. Generate with:  openssl rand -hex 32
# PORTAL_SESSION_SECRET=
# Optional: the public base URL used to build magic-link URLs and redirects.
# Defaults to the request's own origin; set it to pin the customer-facing host.
# PORTAL_BASE_URL=https://crm.travelify.io
